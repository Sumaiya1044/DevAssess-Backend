enum UserRole {
  ADMIN
  COMPANY
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  password     String?
  role         UserRole   @default(CANDIDATE)
  status       UserStatus @default(ACTIVE)
  profileImage String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company      Company?
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  website     String?
  logo        String?
  ownerId     Int      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields:[ownerId], references:[id], onDelete: Cascade)
}
